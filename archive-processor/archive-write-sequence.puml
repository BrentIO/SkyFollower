@startuml
!include ../docs/images/common-sequence.iuml

title Archive Processor — Flight & Parquet Index Write

box "Archive Processor" $OnPrem
    participant "Archiver" as Archiver
    database "s3.db\n(SQLite WAL)" as FallbackDB
end box

box "AWS" $AWS
    participant "S3" as S3
end box

== Normal write ==

Archiver -> S3++ : **Write the flight object**\n""PutObject flights/{YYYY}/{MM}/{DD}/{icao_hex}_{ident}_{uuid}.json.gz""
alt flight write succeeds
    S3 --> Archiver-- : success
    Archiver -> Archiver : **Build the Parquet index single-row file**\n""build_index_s3_key(flight); build_parquet_index_row(flight, s3_key)""
    Archiver -> S3++ : **Write the Parquet index single-row file**\n""PutObject index/year={YYYY}/month={MM}/day={DD}/{uuid}.parquet""
    alt index write succeeds
        S3 --> Archiver-- : success
    else index write fails
        S3 --> Archiver-- : error or timeout
        Archiver -> FallbackDB++ : **Insert index into retry queue**\n""INSERT INTO index_queue {flight_json, s3_key}""
        FallbackDB --> Archiver-- : OK
    end
else flight write fails
    S3 --> Archiver-- : error or timeout
    Archiver -> FallbackDB++ : **Insert flight into the retry queue**\n""INSERT INTO queue {flight_json}""
    FallbackDB --> Archiver-- : OK
end

== Retry: S3 reconnects, or every telemetry_interval_seconds ==

Archiver -> Archiver : **Attempt to claim the flight-queue drain guard**\n""_fallback._drain_lock.acquire(blocking=False)""
alt guard acquired
    Archiver -\ Archiver : **Spawn background drain thread**\n""threading.Thread(target=drain).start()""
    loop for each queued full flight
        Archiver -> FallbackDB++ : **Get next row**\n""SELECT * FROM queue ORDER BY id ASC LIMIT 1""
        FallbackDB --> Archiver-- : Record
        Archiver -> S3++ : **Write the flight object**\n""PutObject flights/{YYYY}/{MM}/{DD}/{icao_hex}_{ident}_{uuid}.json.gz""
        alt flight write succeeds
            S3 --> Archiver-- : success
            Archiver -> Archiver : **Build the Parquet index single-row file**\n""build_index_s3_key(flight); build_parquet_index_row(flight, s3_key)""
            Archiver -> S3++ : **Write the Parquet index single-row file**\n""PutObject index/year={YYYY}/month={MM}/day={DD}/{uuid}.parquet""
            alt index write succeeds
                S3 --> Archiver-- : success
            else index write fails
                S3 --> Archiver-- : error or timeout
                Archiver -> FallbackDB++ : **Insert index into retry queue**\n""INSERT INTO index_queue {flight_json, s3_key}""
                FallbackDB --> Archiver-- : OK
            end
            Archiver -> FallbackDB++ : **Delete drained row**\n""DELETE FROM queue WHERE id = {id}""
            FallbackDB --> Archiver-- : OK
        else flight write fails
            S3 --> Archiver-- : error or timeout
            break
                Archiver -> Archiver : **Stop draining — retry next cycle**
            end
        end
    end
    Archiver -> Archiver : **Release the flight-queue drain guard**\n""_fallback._drain_lock.release()""
else guard already held
    Archiver -> Archiver : **Skip — a flight-queue drain is already in progress**
end

Archiver -> Archiver : **Attempt to claim the index-queue drain guard**\n""_index_fallback._drain_lock.acquire(blocking=False)""
alt guard acquired
    Archiver -\ Archiver : **Spawn background drain thread**\n""threading.Thread(target=drain).start()""
    loop for each queued index-only retry
        Archiver -> FallbackDB++ : **Get next row**\n""SELECT * FROM index_queue ORDER BY id ASC LIMIT 1""
        FallbackDB --> Archiver-- : Record
        Archiver -> S3++ : **Write the Parquet index single-row file**\n""PutObject index/year={YYYY}/month={MM}/day={DD}/{uuid}.parquet""
        alt index write succeeds
            S3 --> Archiver-- : success
            Archiver -> FallbackDB++ : **Delete drained row**\n""DELETE FROM index_queue WHERE id = {id}""
            FallbackDB --> Archiver-- : OK
        else index write fails
            S3 --> Archiver-- : error or timeout
            break
                Archiver -> Archiver : **Stop draining — retry next cycle**
            end
        end
    end
    Archiver -> Archiver : **Release the index-queue drain guard**\n""_index_fallback._drain_lock.release()""
else guard already held
    Archiver -> Archiver : **Skip — an index-queue drain is already in progress**
end

@enduml
