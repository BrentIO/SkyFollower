@startuml
!include ../docs/images/common-sequence.iuml

title Archive Processor — Flight & Parquet Index Write

box "Archive Processor" $OnPrem
    participant "Archiver\n(RabbitMQ consumer thread)" as Consumer
    participant "Archiver\n(worker pool — 12 threads,\nkeyed by icao_hex)" as Worker
    participant "Archiver\n(S3 reconnect thread)" as Reconnect
    participant "Archiver\n(telemetry thread)" as Telemetry
    participant "Archiver\n(draining thread)" as Drainer
    database "s3.db\n(SQLite WAL)" as FallbackDB
end box

box "AWS" $AWS
    participant "S3" as S3
end box

== Normal write (RabbitMQ consumer thread hands off to a worker) ==

Consumer -> Consumer : **Parse the completed flight**\n""CompletedFlight.model_validate_json(body)""
Consumer -\ Worker : **Hand the flight to the worker that owns this aircraft**\n""self._worker_queues[crc32(icao_hex) % N].put((flight, delivery_tag))""
note over Consumer, Worker
    Every segment of one aircraft routes to the same worker and is
    processed FIFO, so split-flight stitching (which reads and writes a
    per-aircraft Redis pointer around the S3 write) is never raced —
    no per-key locking needed. The consumer thread does not wait: the
    worker acks back on this thread once the write finishes.
end note

Worker -> Worker : **Check whether S3 is currently available for direct writes**\n""s3_available = self._s3_connected""
alt s3_available
    Worker -> S3++ : **Write the flight object**\n""PutObject flights/{YYYY}/{MM}/{DD}/{uuid}.json.gz""
    alt flight write succeeds
        S3 --> Worker-- : success
        Worker -> Worker : **Build the Parquet index single-row file**\n""build_index_s3_key(flight); build_parquet_index_row(flight, s3_key)""
        Worker -> S3++ : **Write the Parquet index single-row file**\n""PutObject index/year={YYYY}/month={MM}/day={DD}/{uuid}.parquet""
        alt index write succeeds
            S3 --> Worker-- : success
        else index write fails
            S3 --> Worker-- : error or timeout
            Worker -> FallbackDB++ : **Insert index into retry queue**\n""INSERT INTO index_queue {flight_json, s3_key}""
            FallbackDB --> Worker-- : OK
        end
        Worker -\ Consumer : **Schedule the ack back on the consumer thread**\n""self._rmq_connection.add_callback_threadsafe(lambda: ch.basic_ack(delivery_tag))""
    else flight write fails
        S3 --> Worker-- : error or timeout
        Worker -> FallbackDB++ : **Insert flight into the retry queue**\n""INSERT INTO queue {flight_json}""
        FallbackDB --> Worker-- : OK
        Worker -\ Consumer : **Schedule the ack back on the consumer thread**\n""add_callback_threadsafe(lambda: ch.basic_ack(delivery_tag))""
    end
else not s3_available
    Worker -> FallbackDB++ : **Insert flight into the retry queue**\n""INSERT INTO queue {flight_json}""
    FallbackDB --> Worker-- : OK
    Worker -\ Consumer : **Schedule the ack back on the consumer thread**\n""add_callback_threadsafe(lambda: ch.basic_ack(delivery_tag))""
end
note over Consumer
    If the fallback INSERT itself raises, the worker does NOT schedule an
    ack — the message stays unacked and RabbitMQ redelivers it (S3 keys
    are derived from the flight's stable UUID, so a re-archive overwrites
    rather than duplicates).
end note

== Drain loop (FallbackQueue.drain) — shared by every trigger below ==

loop for each queued row, oldest first
    Drainer -> FallbackDB++ : **Get next row**\n""SELECT id, payload, retry_count, last_attempted_at FROM {table} ORDER BY id ASC LIMIT 1""
    FallbackDB --> Drainer-- : Record
    alt row attempted less than min_retry_interval_seconds ago (default 30s)
        break
            Drainer -> Drainer : **Stop draining**\n""still cooling down — a flapping trigger can't rush this row to the poison threshold; drain() returns False""
        end
    else row eligible to retry
        Drainer -> Drainer : **Run this row's write callback**\n""process_fn(payload)""
        alt callback succeeds
            Drainer -> FallbackDB++ : **Delete the drained row**\n""DELETE FROM {table} WHERE id = {id}""
            FallbackDB --> Drainer-- : OK
        else callback raises
            Drainer -> Drainer : **Count this failure**\n""new_count = retry_count + 1""
            alt new_count reaches the retry threshold (5)
                Drainer -> FallbackDB++ : **Delete the poison row**\n""DELETE FROM {table} WHERE id = {id}""
                FallbackDB --> Drainer-- : OK
                Drainer -> Drainer : **Dead-letter the payload**\n""write dead_letters/{table}/{timestamp}_{id}.json""
                note right of Drainer
                    Judged permanently unrecoverable, not just a
                    transient outage — draining continues to the
                    next row instead of stopping, which is what
                    keeps one poison row from blocking everything
                    queued behind it forever.
                end note
            else new_count still below the retry threshold
                Drainer -> FallbackDB++ : **Record the failed attempt**\n""UPDATE {table} SET retry_count = {new_count}, last_attempted_at = {now} WHERE id = {id}""
                FallbackDB --> Drainer-- : OK
                break
                    Drainer -> Drainer : **Stop draining — retry next trigger**\n""drain() returns False""
                end
            end
        end
    end
end

== Flight-queue write callback (_process_fallback_flight) ==

Drainer -> S3++ : **Write the flight object**\n""PutObject flights/{YYYY}/{MM}/{DD}/{uuid}.json.gz""
alt flight write succeeds
    S3 --> Drainer-- : success
    Drainer -> Drainer : **Build the Parquet index single-row file**\n""build_index_s3_key(flight); build_parquet_index_row(flight, s3_key)""
    Drainer -> S3++ : **Write the Parquet index single-row file**\n""PutObject index/year={YYYY}/month={MM}/day={DD}/{uuid}.parquet""
    alt index write succeeds
        S3 --> Drainer-- : success
    else index write fails
        S3 --> Drainer-- : error or timeout
        Drainer -> FallbackDB++ : **Insert index into its own retry queue**\n""INSERT INTO index_queue {flight_json, s3_key}""
        FallbackDB --> Drainer-- : OK
    end
else flight write fails
    S3 --> Drainer-- : error or timeout
    Drainer -> Drainer : **Raise — the drain loop above counts this as a failed attempt**
end

== Index-queue write callback ==

Drainer -> S3++ : **Write the Parquet index single-row file**\n""PutObject index/year={YYYY}/month={MM}/day={DD}/{uuid}.parquet""
alt write succeeds
    S3 --> Drainer-- : success
else write fails
    S3 --> Drainer-- : error or timeout
    Drainer -> Drainer : **Raise — the drain loop above counts this as a failed attempt**
end

== S3 reconnects — flight queue drains synchronously before live writes resume ==

note over Reconnect, Consumer
    See split-flight-stitching-sequence.puml for why a continuation
    segment must never be live-processed before the segment it continues.
end note

par S3 reconnect thread — draining the backlog
    Reconnect -> Reconnect : **Establish a new S3 client, verify reachable**\n""_connect_s3(): client.head_bucket(Bucket=bucket)""
    Reconnect -> Reconnect : **Drain the flight queue synchronously**\n""self._fallback.drain(self._process_fallback_flight)""
    note right of Reconnect
        Refer to "Drain loop" and "Flight-queue write callback" above.
    end note
    alt queue fully drained
        Reconnect -> Reconnect : **Set S3 connected — now safe to route live flights directly**\n""self._s3_connected = True""
        Reconnect -\ FallbackDB : **Kick off the index-queue background drain too**\n""self._drain_index_fallback()""
    end
else Worker pool — concurrent arrivals during the drain above
    Worker -> Worker : **Check whether S3 is currently available for direct writes**\n""s3_available = self._s3_connected""
    Worker -> Worker : **Still False — the drain hasn't finished yet**
    Worker -> FallbackDB++ : **Queue behind the backlog instead of writing directly**\n""INSERT INTO queue {flight_json}""
    FallbackDB --> Worker-- : OK
end

== Every telemetry_interval_seconds while s3_connected — flight-queue background safety sweep (only matters for a flight re-queued by a single transient error while otherwise connected) ==

Telemetry -> Telemetry : **Attempt to claim the flight-queue drain guard**\n""_fallback._drain_lock.acquire(blocking=False)""
alt guard acquired
    Telemetry -\ FallbackDB : **Spawn background drain thread**\n""self._fallback.drain_in_background(self._process_fallback_flight)""
    note right of Telemetry
        Refer to "Drain loop" and "Flight-queue write callback" above.
    end note
else guard already held
    Telemetry -> Telemetry : **Skip — a flight-queue drain is already in progress**
end

== S3 reconnects (after the synchronous flight drain succeeds) or every telemetry_interval_seconds — index queue (only retries a Parquet index row for a flight object that already wrote successfully) ==

Telemetry -> Telemetry : **Attempt to claim the index-queue drain guard**\n""_index_fallback._drain_lock.acquire(blocking=False)""
alt guard acquired
    Telemetry -\ FallbackDB : **Spawn background drain thread**\n""self._index_fallback.drain_in_background(process)""
    note right of Telemetry
        Refer to "Drain loop" and "Index-queue write callback" above.
    end note
else guard already held
    Telemetry -> Telemetry : **Skip — an index-queue drain is already in progress**
end

@enduml
