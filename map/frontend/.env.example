# Copy to .env (or .env.local) before `npm run dev` / `npm run build`.
# Vite bakes every VITE_* value into the built bundle at build time, not
# read at container runtime -- same convention as
# management-ui/frontend's VITE_VERSION/VITE_COMMIT (see its Dockerfile).

# Base URL of the map backend's REST/WebSocket API (map/README.md's
# MAP_HTTP_HOST:MAP_HTTP_PORT), e.g. http://map-host:80. Leave unset (or
# empty) to use same-origin -- appropriate only if this frontend's built
# assets end up served from the same host/port as the map service itself.
VITE_MAP_API_BASE_URL=http://localhost:80

# Centered reference point ("home") for the on-map marker and the initial
# camera position. Both required for the home marker/initial centering to
# appear -- the map still renders without them (falls back to a wide world
# view), just without a home marker or recenter target.
VITE_HOME_LATITUDE=33.9425
VITE_HOME_LONGITUDE=-118.4081
