# Copy to .env (or .env.local) before `npm run dev` / `npm run build`.
# Vite bakes every VITE_* value into the built bundle at build time, not
# read at container runtime -- same convention as
# management-ui/frontend's VITE_VERSION/VITE_COMMIT (see its Dockerfile).

# Base URL of the map backend's REST/WebSocket API (map/README.md's
# MAP_HTTP_HOST:MAP_HTTP_PORT), e.g. http://map-host:80. Leave unset (or
# empty) to use same-origin -- appropriate only if this frontend's built
# assets end up served from the same host/port as the map service itself.
VITE_MAP_API_BASE_URL=http://localhost:80

# DEV-ONLY FALLBACK for the centered reference point ("home") used for the
# on-map marker and initial camera position. In a real build/deployment,
# home comes from the backend's GET /api/config at runtime (MAP_HOME_LATITUDE/
# MAP_HOME_LONGITUDE in the map service's own .env -- see map/README.md's
# Configuration section) -- these two are read only when running
# `npm run dev` (import.meta.env.DEV), since Vite's dev server has no
# backend at the same origin to serve /api/config unless a proxy is set
# up. They have no effect on a production build. Both required together,
# or neither -- without them `npm run dev` still renders, just without a
# home marker or recenter target.
VITE_HOME_LATITUDE=33.9425
VITE_HOME_LONGITUDE=-118.4081
