# The repo-root .gitignore blanket-ignores *.svg (generated PlantUML
# diagrams etc.). The vendored aircraft silhouettes are source assets --
# re-include them.
!src/assets/aircraft-shapes/*.svg

# Generated by scripts/generate-aircraft-shapes.mjs on every predev/prebuild
# from src/assets/aircraft-shapes/*.svg -- the vendored SVGs are the single
# source of truth, this extract is not committed.
src/lib/aircraftShapes.generated.ts
