@startuml
!include ../docs/images/common-sequence.iuml

title Message Processor — Route Leg Resolution

box "Message Processor" $OnPrem
    participant "Processor" as Processor
end box

box "Redis" $OnPrem
    database "route:{ident}\nairport:{code}" as Redis
end box

== On archive, once per completed flight with a known ident ==

Processor -> Redis++ : **Resolve the route's airport records**\n""EVALSHA route_airports.lua ident""
Redis --> Processor-- : ordered airport records, or ""[]""

alt fewer than 2 airport records resolved
    Processor -> Processor : **Leave unresolved**\norigin, destination = None, None

else exactly 2 airports (direct route, no ambiguity)
    Processor -> Processor : **Candidate leg = the only pair**\norigin, destination = airports[0], airports[1]

else 3+ airports (multi-leg route)
    Processor -> Processor : **Try low-altitude proximity + climb/descent**\nfirst position < 10,000ft and near exactly one waypoint\n(climbing away = origin; descending toward = destination)
    opt not resolved by proximity
        Processor -> Processor : **Try cruise heading vs. candidate-leg bearing**\nclosest candidate <= 30° off, and >= 15° clear of the runner-up
    end
    opt still not resolved
        Processor -> Processor : **Leave unresolved**\norigin, destination = None, None
    end
end

opt a candidate leg was resolved
    Processor -> Processor : **Sanity-check against the observed track**\ncross_track_distance_nm(position, origin, destination) for every position
    alt any position exceeds max(150nm, 30% * route_distance)
        Processor -> Processor : **Reject — leave unresolved**\norigin, destination = None, None
    else every position within tolerance
        Processor -> Processor : **Set CompletedFlight.origin/destination**\nflight.origin, flight.destination = origin.icao_code, destination.icao_code
    end
end

@enduml
