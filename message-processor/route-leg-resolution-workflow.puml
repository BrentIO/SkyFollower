@startuml
!include ../docs/images/common.iuml

!$OnPrem = "#a8e5fa"

title Message Processor — Route Leg Resolution Workflow

start

partition "Message Processor" $OnPrem {

:**A message updates the flight's state**\nident / position / velocity / etc.;

if (**Already resolved this flight?**\n""flight.route_resolution_attempted"") then (yes)
  stop
endif

if (**Ident known, and not just the aircraft's own tail number?**\n""flight.ident and not _ident_matches_registration(...)"") then (no)
  :Not ready yet -- wait for a later message;
  stop
endif

if (**A position with altitude has been received?**) then (no)
  :Not ready yet -- wait for a later message;
  stop
endif

if (**A velocity with heading has been received?**) then (no)
  :Not ready yet -- wait for a later message;
  stop
endif

:**Mark this flight as attempted**\n""flight.route_resolution_attempted = True""\n(never re-queried again this flight, resolved or not);

}

partition "Redis" $OnPrem {
:**Resolve the route's airport records**\n""EVALSHA route_airports.lua ident"";
}

partition "Message Processor" $OnPrem {

if (**Fewer than 2 airport records resolved?**) then (yes)
  stop
endif

if (**Exactly 2 airports?**\n(direct route, no ambiguity)) then (yes)
  :Candidate leg = the only pair;
else (3+ airports -- multi-leg route)
  :**Try low-altitude proximity + climb/descent**\nfirst position < 10,000ft and near exactly one waypoint\n(climbing away = origin; descending toward = destination);
  if (resolved?) then (no)
    :**Try cruise heading vs. candidate-leg bearing**\nclosest candidate <= 30° off, and >= 15° clear of the runner-up;
    if (resolved?) then (no)
      :Leave origin/destination unset;
      stop
    endif
  endif
endif

:**Sanity-check against the observed track**\n""cross_track_distance_nm(position, origin, destination)""\nfor every position received so far;

if (**Any position exceeds max(150nm, 30% * route_distance)?**) then (yes)
  :Reject -- leave origin/destination unset;
  stop
else (no)
  :**Set origin/destination**\n""flight.origin, flight.destination = origin.icao_code, destination.icao_code"";
  stop
endif

}

@enduml
