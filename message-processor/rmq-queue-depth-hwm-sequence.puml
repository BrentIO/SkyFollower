@startuml
!include ../docs/images/common-sequence.iuml

title Message Processor — RabbitMQ Queue-Depth High-Water Mark

box "Message Processor" $OnPrem
    participant "Processor" as Processor
end box

box "RabbitMQ" $OnPrem
    queue "skyfollower-message-processor-{MESSAGE_PROCESSOR_ID}" as InputQ
end box

box "MQTT" $OnPrem
    participant "MQTT Broker" as MQTT
end box

== Every 10 seconds, independent of telemetry_interval_seconds ==

loop until shutdown
    Processor -> Processor : **Sleep 10 seconds**
    alt consumer channel connected
        Processor -> Processor : **Schedule the declare on the connection's own thread**\n""connection.add_callback_threadsafe(_sample_on_rmq_thread)""
        Processor -> InputQ++ : **Read queue depth**\n""queue_declare(queue=skyfollower-message-processor-{id}, durable=True, passive=True)""
        InputQ --> Processor-- : message_count
        Processor -> Processor : **Record into high-water mark**\n""hwm.record(message_count)""
    else not connected yet, or declare raises
        Processor -> Processor : **Record into high-water mark**\n""hwm.record(-1)""
    end
end

== Independently, every telemetry_interval_seconds ==

Processor -> Processor : **Read and reset the high-water mark**\n""depth_hwm = hwm.value_and_reset()""
alt depth_hwm != -1
    Processor -\ MQTT : **Publish telemetry**\n""SkyFollower/message-processor/{id}/statistic/rabbitmq_input_queue_depth_hwm"" (retain=True)
else no valid sample landed this window
    Processor -> Processor : **Skip this cycle's publish**\n""-- retained topic keeps its last known-good value --""
end

@enduml
