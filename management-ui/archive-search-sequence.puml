@startuml
!include ../docs/images/common-sequence.iuml

title Management UI Backend — Archive Search (Athena/Glue query layer)

box "Management UI Backend" $OnPrem
    participant "Backend\n(request thread)" as Backend
    participant "Backend\n(poll thread)" as Poll
    database "Redis" as Redis
end box

box "AWS" $AWS
    participant "Athena" as Athena
    participant "S3" as S3
end box

== Create a search ==

Backend -> Backend : **Validate the WHERE clause**\n""_validate_where_clause(where_clause)""
opt explicit start_date is after explicit end_date
    Backend --> Backend : HTTP 400
end
Backend -> Backend : **Resolve the date range and derive a partition predicate**\n""_resolve_search_range(where_clause, start_date, end_date)""
alt resolved range is empty (explicit range and where_clause's own derived range don't overlap)
    Backend -> Redis++ : **Write an already-COMPLETE, zero-row search record**\n""SET archive_search:{uuid} {status: COMPLETE, query_execution_id: null} EX 7d""
    Redis --> Backend-- : OK
    Backend -> Redis++ : **Add to the search index**\n""SADD archive_search:index {uuid}""
    Redis --> Backend-- : OK
    Backend --> Backend : HTTP 202 {uuid}
else resolved range is non-empty
    Backend -> Backend : **Inject the partition predicate**\n""_build_search_query(partition_predicate, where_clause)""
    Backend -> Athena++ : **Start the query**\n""start_query_execution(QueryString, Database, WorkGroup)""
    alt start succeeds
        Athena --> Backend-- : QueryExecutionId
        Backend -> Redis++ : **Write the search record**\n""SET archive_search:{uuid} {...} EX 7d""
        Redis --> Backend-- : OK
        Backend -> Redis++ : **Add to the search index**\n""SADD archive_search:index {uuid}""
        Redis --> Backend-- : OK
        Backend -\ Poll : **Spawn the polling thread**\n""threading.Thread(target=_poll_search_execution).start()""
        Backend --> Backend : HTTP 202 {uuid}
    else start fails (e.g. a permissions mismatch)
        Athena --> Backend-- : error
        Backend --> Backend : HTTP 502
    end
end

== Background polling (exponential backoff, 2-minute deadline) ==

loop until terminal state or deadline
    Poll -> Poll : **Sleep (backoff)**\n""1s, 2s, 4s, 8s, 16s, then capped at 30s""
    Poll -> Athena++ : **Check status**\n""get_query_execution(QueryExecutionId)""
    Athena --> Poll-- : State
    alt SUCCEEDED
        Poll -> Redis++ : **Mark complete**\n""SET ... XX KEEPTTL {status: COMPLETE}""
        Redis --> Poll-- : OK
        break
            Poll -> Poll : **Done**
        end
    else FAILED or CANCELLED
        Poll -> Redis++ : **Mark failed**\n""SET ... XX KEEPTTL {status: FAILED, error: reason}""
        Redis --> Poll-- : OK
        break
            Poll -> Poll : **Done**
        end
    else still running
        Poll -> Poll : **Keep polling**
    end
end

opt deadline exceeded without a terminal state
    Poll -\ Athena : **Best-effort cancel**\n""stop_query_execution(QueryExecutionId)""
    Poll -> Redis++ : **Mark aborted**\n""SET ... XX KEEPTTL {status: ABORTED}""
    Redis --> Poll-- : OK
end

note over Poll, Redis
    Every write here is SET ... XX -- a no-op if DELETE has already
    removed the key, so a poll landing after the user deletes the
    search can never resurrect it (see Delete below).
end note

== List active searches (also runs at startup, to reconcile any stuck RUNNING record) ==

Backend -> Redis++ : **Get every tracked search uuid**\n""SMEMBERS archive_search:index""
Redis --> Backend-- : {uuid, ...}
loop for each uuid
    Backend -> Redis++ : **Load that search's record**\n""GET archive_search:{uuid}""
    alt record still exists
        Redis --> Backend-- : record
        Backend -> Backend : **Include it in the result**
    else record already expired (7-day TTL) -- the index couldn't know
        Redis --> Backend-- : none
        Backend -> Redis++ : **Prune the stale index entry**\n""SREM archive_search:index {uuid}""
        Redis --> Backend-- : OK
    end
end
Backend --> Backend : HTTP 200 [summaries]

== Fetch a page of results (first request for this search) ==

Backend -> Redis++ : **Load the search record**\n""GET archive_search:{uuid}""
Redis --> Backend-- : record or none
alt search not found
    Backend --> Backend : HTTP 404
else status != COMPLETE
    Backend --> Backend : HTTP 400
else status == COMPLETE
    Backend -> Athena++ : **Fetch up to 501 result rows (one call, ever, per search)**\n""get_query_results(QueryExecutionId, MaxResults=501)""
    alt fetch succeeds
        Athena --> Backend-- : header row + up to 501 data rows
        Backend -> Backend : **Cache the first 500, note whether a 501st exists**\n""_result_cache.put(uuid, {rows: rows[:500], truncated})""
        Backend -> Backend : **Encrypt each cached row's s3_key into a fetch token**\n""Fernet(...).encrypt(s3_key)""
        alt requested page is beyond the cached rows
            Backend --> Backend : HTTP 400
        else
            Backend --> Backend : HTTP 200 [rows][page][truncated]
        end
    else fetch fails (e.g. a permissions mismatch)
        Athena --> Backend-- : error
        Backend --> Backend : HTTP 502
    end
end

note over Backend, Athena
    Every later page for the same search, including a re-sort of it, is
    served from the cache above with no further Athena call at all.
end note

== Download the full result set (every row, no size threshold -- see the "Download" README section) ==

Backend -> Redis++ : **Load the search record**\n""GET archive_search:{uuid}""
Redis --> Backend-- : record or none
alt search not found
    Backend --> Backend : HTTP 404
else status != COMPLETE
    Backend --> Backend : HTTP 400
else a download result location is already persisted (a previous click already ran this query)
    Backend -> Backend : **Reuse it -- no new Athena call at all**
    Backend -> Backend : **Presign the result object**\n""generate_presigned_url(Bucket, Key, ExpiresIn=15m)""
    Backend --> Backend : HTTP 307 -> presigned URL
else first download click for this search
    Backend -> Backend : **Build the sanitized, s3_key-free query**\n""_build_download_query(partition_predicate, where_clause)""
    Backend -> Athena++ : **Start the download query**\n""start_query_execution(QueryString, Database, WorkGroup)""
    alt start succeeds
        Athena --> Backend-- : QueryExecutionId
        Backend -> Redis++ : **Persist it on the search record**\n""SET ... XX KEEPTTL {download_query_execution_id}""
        Redis --> Backend-- : OK
        loop until terminal state or deadline
            Backend -> Athena++ : **Check status**\n""get_query_execution(QueryExecutionId)""
            Athena --> Backend-- : State
            alt SUCCEEDED
                break
                    Backend -> Backend : **Done**
                end
            else FAILED or CANCELLED
                break
                    Backend -> Backend : **Done**
                end
            else still running
                Backend -> Backend : **Sleep (backoff)**\n""1s, 2s, 4s, 8s, 16s, then capped at 30s""
            end
        end
        alt query succeeded
            Backend -> Athena++ : **Find the result file**\n""get_query_execution(QueryExecutionId).ResultConfiguration.OutputLocation""
            Athena --> Backend-- : s3://bucket/athena-results/{id}.csv
            Backend -> Redis++ : **Persist it on the search record**\n""SET ... XX KEEPTTL {download_output_location}""
            Redis --> Backend-- : OK
            Backend -> Backend : **Presign the result object**\n""generate_presigned_url(Bucket, Key, ExpiresIn=15m)""
            Backend --> Backend : HTTP 307 -> presigned URL
        else query failed
            Backend --> Backend : HTTP 502
        else deadline exceeded without ever reaching a terminal state
            Backend --> Backend : HTTP 504
        end
    else start fails (e.g. a permissions mismatch)
        Athena --> Backend-- : error
        Backend --> Backend : HTTP 502
    end
end

== Fetch a flight by its encrypted token ==

Backend -> Backend : **Decrypt the token**\n""Fernet(...).decrypt(token)""
alt token valid
    Backend -> S3++ : **Download the flight object**\n""GetObject flights/{...}.json.gz""
    alt download succeeds
        S3 --> Backend-- : gzipped flight JSON
        Backend --> Backend : HTTP 200 (attachment download)
    else download fails (e.g. the object is gone, or a permissions mismatch)
        S3 --> Backend-- : error
        Backend --> Backend : HTTP 502
    end
else token invalid or expired (process restarted since minting)
    Backend --> Backend : HTTP 400
end

== Delete a search ==

Backend -> Redis++ : **Load the search record**\n""GET archive_search:{uuid}""
Redis --> Backend-- : {status, query_execution_id}
opt status == RUNNING
    Backend -\ Athena : **Best-effort cancel**\n""stop_query_execution(QueryExecutionId)""
end
opt status == COMPLETE
    Backend -> Athena++ : **Find the result file**\n""get_query_execution(QueryExecutionId)""
    Athena --> Backend-- : OutputLocation
    Backend -> S3++ : **Delete the result file**\n""DeleteObject""
    S3 --> Backend-- : OK
end
Backend -> Redis++ : **Delete the search record**\n""DEL archive_search:{uuid}""
Redis --> Backend-- : OK
Backend -> Redis++ : **Remove from the search index**\n""SREM archive_search:index {uuid}""
Redis --> Backend-- : OK
Backend -> Backend : **Evict from the in-process LRU, if present**\n""_result_cache.discard(uuid)""
Backend --> Backend : HTTP 204

@enduml
