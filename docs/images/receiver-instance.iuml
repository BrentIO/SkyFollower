' Shared shape for a single Receiver instance's core (the process plus its
' RabbitMQ offline-fallback queue and drain arrows) -- identical for every
' Receiver instance regardless of what it's ingesting. Defined once here so
' per-diagram instantiations don't hand-duplicate this shape.
!procedure $receiverCore($comp_alias, $fallback_alias)
component "Receiver\n--\nTags: raw, icao_hex, received_at, source\nPublishes: exchange adsb, routing key icao_hex" as $comp_alias
database "queue.db\n(SQLite WAL)" as $fallback_alias
$comp_alias -right-> $fallback_alias : RabbitMQ offline
$fallback_alias .left.> $comp_alias : Drains on RabbitMQ reconnect\nor every telemetry tick
!endprocedure
