node_modules
.vitepress/cache
.vitepress/dist

# Generated by scripts/generate-pages.mjs — source of truth is the
# READMEs these are copied and link-rewritten from, not these files. A
# wildcard (not one entry per component) so a newly-discovered
# component never needs a line added here — components/index.md is the
# one file in this directory that IS hand-authored and checked in, hence
# the negation.
components/*.md
!components/index.md
runners/

# Generated by scripts/generate-diagrams.mjs from each component's own
# .puml file(s) — copied here from receiver/receiver.svg etc. so
# each component's generated page can embed them. Source of truth is the
# .puml. A component may have more than one diagram, so this is a wildcard
# rather than one entry per file.
components/*.svg

# Generated by scripts/bundle-specs.mjs — each spec is copied from
# specs/*.yaml (public/asyncapi/ also gets the AsyncAPI web component
# bundle copied from node_modules; the OpenAPI viewer is swagger-ui-dist,
# bundled normally by Vite, so public/openapi/ only holds the spec).
# Neither belongs committed here.
public/asyncapi/
public/openapi/

# Generated by scripts/generate-diagrams.mjs — each PlantUML
# diagram's rendered SVG is mirrored here (at its literal relative path)
# so its "click to enlarge" link resolves; source of truth is the .puml.
# Add an entry here for each new diagram's page directory.
public/architecture/
