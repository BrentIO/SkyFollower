@startuml
' Pure include-fragment: consumed by pipeline.puml via
' `!includesub central-server.puml!COMPONENT`, never displayed as a
' standalone diagram. generate-diagrams.mjs still renders this file to
' central-server.svg like every other .puml (see that script's comments) —
' nothing references the standalone SVG, but that's a harmless, intentional
' side effect of keeping the generator's file-discovery simple, not a bug.
' See issue #1867.
!include_once ../../images/common-component.iuml

!startsub COMPONENT
package "Central Server" as CentralSvr $OnPrem {
    package "RabbitMQ" as Rabbit {
        entity "adsb\n(x-consistent-hash)" as adsbx
        queue "skyfollower-message-processor-{MESSAGE_PROCESSOR_ID}" as adsbq
        queue "archive" as archiveq

        adsbx -down-> adsbq : Routing key icao_hex,\nbinding weight 1
    }
    database "Redis" as Redis
}
!endsub

@enduml
