@startuml
!include ../../images/common-sequence.iuml

title Message Processor — RabbitMQ Offline Fallback

box "Message Processor" $OnPrem
    participant "Processor" as Processor
    database "completed_flights.db" as ProcessorDB
end box

box "RabbitMQ" $OnPrem
    queue "archive" as ArchiveQ
end box

== Normal operation ==

Processor -> ArchiveQ++ : **Connect**
ArchiveQ --> Processor-- : Connected
Processor -> Processor : **Set RabbitMQ is Connected**\n""rmq_connected = True""
Processor -> Processor : **Check if RabbitMQ is connected**\n""if rmq_connected and rmq_channel:""
alt connected
    Processor -\ ArchiveQ : **Publish**
    opt channel already closed locally
        Processor -> Processor : **Local publish failure**\n""basic_publish() raises""
        Processor -> Processor : **Set RabbitMQ is Disconnected**\n""rmq_connected = False""
        Processor -> ProcessorDB++ : **Write database entry**\n""INSERT INTO queue {flight_json}""
        ProcessorDB --> Processor-- : OK
    end
else not connected
    Processor -> ProcessorDB++ : **Write database entry**\n""INSERT INTO queue {flight_json}""
    ProcessorDB --> Processor-- : OK
end

== RabbitMQ connection drops ==

ArchiveQ ->x Processor : **Connection lost**
Processor -> Processor : **Connection monitoring detects the drop**\n""start_consuming() raises""
Processor -> Processor : **Set RabbitMQ is Disconnected**\n""rmq_connected = False""

loop Until reconnected
    alt Connection fails
        Processor ->x ArchiveQ : **Connect**
        Processor -> Processor : **Sleep 10 seconds**
    else Connection succeeds
        Processor -> ArchiveQ++ : **Connect**
        ArchiveQ --> Processor-- : Connected
        Processor -> Processor : **Set RabbitMQ is Connected**\n""rmq_connected = True""
    end
end

opt Message arrives while disconnected from RabbitMQ
    loop For each message
        Processor -> ProcessorDB++ : **Write database entry**\n""INSERT INTO queue {flight_json}""
        ProcessorDB --> Processor-- : OK
    end
end

== Draining completed_flights.db (reconnect-triggered) ==

Processor -> Processor : **Attempt to claim the drain guard**\n""_drain_lock.acquire(blocking=False)""
alt guard acquired
    Processor -\ Processor : **Spawn background drain thread**\n""threading.Thread(target=drain).start()""
    loop For each row in database
        Processor -> ProcessorDB++ : **Get next row**\n""SELECT id, payload, retry_count, last_attempted_at FROM queue ORDER BY id ASC LIMIT 1""
        ProcessorDB --> Processor-- : Record
        alt row attempted less than 30s ago
            break
                Processor -> Processor : **Stop draining**\n""still cooling down — a flapping reconnect can't rush this row to the poison threshold""
            end
        else row eligible to retry
            Processor -\ ArchiveQ : **Publish**
            alt basic_publish succeeds
                Processor -> ProcessorDB++ : **Delete published row**\n""DELETE FROM queue WHERE id = {id}""
                ProcessorDB --> Processor-- : OK
            else basic_publish raises error
                Processor -> Processor : **Set RabbitMQ is Disconnected**\n""rmq_connected = False""
                Processor -> Processor : **Count this failure**\n""new_count = retry_count + 1""
                alt new_count reaches the retry threshold (5)
                    Processor -> ProcessorDB++ : **Delete the poison row**\n""DELETE FROM queue WHERE id = {id}""
                    ProcessorDB --> Processor-- : OK
                    Processor -> Processor : **Dead-letter the payload**\n""write dead_letters/queue/{timestamp}_{id}.json""
                    note right of Processor
                        Judged permanently unrecoverable, not just a
                        transient outage — draining continues to the next
                        row instead of stopping, which is what keeps one
                        poison flight from blocking everything queued
                        behind it forever.
                    end note
                else new_count still below the retry threshold
                    Processor -> ProcessorDB++ : **Record the failed attempt**\n""UPDATE queue SET retry_count = {new_count}, last_attempted_at = {now} WHERE id = {id}""
                    ProcessorDB --> Processor-- : OK
                    break
                        Processor -> Processor : **Stop draining**\n""could still just be RabbitMQ down again""
                    end
                end
            end
        end
    end
    Processor -> Processor : **Release the drain guard**\n""_drain_lock.release()""
else guard already held
    Processor -> Processor : **Skip — a drain is already in progress**
end

== Independently, every telemetry_interval_seconds (catches failures that never dropped the connection) ==

Processor -> Processor : **Check if RabbitMQ is connected**\n""if rmq_connected:""
alt connected
    note right of Processor
        Refer to //Draining completed_flights.db (reconnect-triggered)//
        above — this trigger calls the identical ""_drain_fallback()"",
        including its single-flight guard.
    end note
else not connected
    Processor -> Processor : **Skip — nothing to do this tick**
end

@enduml
