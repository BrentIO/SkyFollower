@startuml
!include ../../images/common-sequence.iuml

title Receiver Offline Fallback

box "Receiver" $OnPrem
    participant "Receiver" as Receiver
    database "queue.db" as ReceiverDB
end box

box "RabbitMQ" $OnPrem
    queue "adsb-{n}" as AdsbQ
end box

Receiver -> AdsbQ : **Publish** attempt fails
note over AdsbQ
    RabbitMQ unreachable
end note
Receiver -> ReceiverDB : **Write** (SQLite WAL)

loop while RabbitMQ unreachable
    Receiver -> AdsbQ : **Publish** attempt fails
    Receiver -> ReceiverDB : **Write** (SQLite WAL)
end

alt RabbitMQ connection-level reconnect detected
    Receiver -> AdsbQ++ : **Reconnect**
    AdsbQ --> Receiver-- : Connected
    Receiver -> ReceiverDB : **Drain** oldest-first
    ReceiverDB --> Receiver : buffered messages
    Receiver -> AdsbQ : **Publish** each drained message
else every telemetry_interval_seconds
    Receiver -> Receiver : **Check** rmq_connected
    note right of Receiver
        Independent backstop: a publish failure can
        leave messages queued without the underlying
        connection ever raising an error, so the
        reconnect branch above never fires for it.
    end note
    Receiver -> ReceiverDB : **Drain** oldest-first
    ReceiverDB --> Receiver : buffered messages
    Receiver -> AdsbQ : **Publish** each drained message
end

@enduml
