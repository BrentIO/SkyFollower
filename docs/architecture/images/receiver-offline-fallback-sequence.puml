@startuml
!include ../../images/common-sequence.iuml

title Receiver — RabbitMQ Offline Fallback

box "Receiver" $OnPrem
    participant "Receiver" as Receiver
    database "queue.db" as ReceiverDB
end box

box "RabbitMQ" $OnPrem
    queue "adsb-{n}" as AdsbQ
end box

== Normal operation ==

Receiver -> AdsbQ++ : **Connect**
AdsbQ --> Receiver-- : Connected
Receiver -> Receiver : **Set RabbitMQ is Connected**\n""rmq_connected = True""
Receiver -> Receiver : **Check if RabbitMQ is connected**\n""if rmq_connected:""
alt connected
    Receiver -\ AdsbQ : **Publish**
    opt channel already closed locally
        Receiver -> Receiver : **Local publish failure**\n""basic_publish() raises""
        Receiver -> Receiver : **Set RabbitMQ is Disconnected**\n""rmq_connected = False""
        Receiver -> ReceiverDB++ : **Write database entry**\n""INSERT INTO queue {queue_name, message_json}""
        ReceiverDB --> Receiver-- : OK
    end
else not connected
    Receiver -> ReceiverDB++ : **Write database entry**\n""INSERT INTO queue {queue_name, message_json}""
    ReceiverDB --> Receiver-- : OK
end

== RabbitMQ connection drops ==

AdsbQ ->x Receiver : **Connection lost**
Receiver -> Receiver : **Connection monitoring detects the drop**\n""conn.process_data_events() raises""
Receiver -> Receiver : **Set RabbitMQ is Disconnected**\n""rmq_connected = False""

loop Until reconnected
    alt Connection fails
        Receiver ->x AdsbQ : **Connect**
        Receiver -> Receiver : **Sleep 10 seconds**
    else Connection succeeds
        Receiver -> AdsbQ++ : **Connect**
        AdsbQ --> Receiver-- : Connected
        Receiver -> Receiver : **Set RabbitMQ is Connected**\n""rmq_connected = True""
    end
end

opt Message arrives while disconnected from RabbitMQ
    loop For each message
        Receiver -> ReceiverDB++ : **Write database entry**\n""INSERT INTO queue {queue_name, message_json}""
        ReceiverDB --> Receiver-- : OK
    end
end

== Draining queue.db (reconnect-triggered) ==

Receiver -> Receiver : **Attempt to claim the drain guard**\n""_drain_lock.acquire(blocking=False)""
alt guard acquired
    Receiver -\ Receiver : **Spawn background drain thread**\n""threading.Thread(target=drain).start()""
    loop For each row in database
        Receiver -> ReceiverDB++ : **Get next row**\n""SELECT id, payload, retry_count FROM queue ORDER BY id ASC LIMIT 1""
        ReceiverDB --> Receiver-- : Record
        Receiver -\ AdsbQ : **Publish**
        alt basic_publish succeeds
            Receiver -> ReceiverDB++ : **Delete published row**\n""DELETE FROM queue WHERE id = {id}""
            ReceiverDB --> Receiver-- : OK
        else basic_publish raises error
            Receiver -> Receiver : **Set RabbitMQ is Disconnected**\n""rmq_connected = False""
            Receiver -> Receiver : **Count this failure**\n""new_count = retry_count + 1""
            alt new_count reaches the retry threshold (5)
                Receiver -> ReceiverDB++ : **Delete the poison row**\n""DELETE FROM queue WHERE id = {id}""
                ReceiverDB --> Receiver-- : OK
                Receiver -> Receiver : **Dead-letter the payload**\n""write dead_letters/queue/{timestamp}_{id}.json""
                note right of Receiver
                    Judged permanently unrecoverable, not just a
                    transient outage — draining continues to the next
                    row instead of stopping, which is what keeps one
                    poison message from blocking everything queued
                    behind it forever.
                end note
            else new_count still below the retry threshold
                Receiver -> ReceiverDB++ : **Record the failed attempt**\n""UPDATE queue SET retry_count = {new_count} WHERE id = {id}""
                ReceiverDB --> Receiver-- : OK
                break
                    Receiver -> Receiver : **Stop draining**\n""could still just be RabbitMQ down again""
                end
            end
        end
    end
    Receiver -> Receiver : **Release the drain guard**\n""_drain_lock.release()""
else guard already held
    Receiver -> Receiver : **Skip — a drain is already in progress**
end

== Independently, every telemetry_interval_seconds (catches failures that never dropped the connection) ==

Receiver -> Receiver : **Check if RabbitMQ is connected**\n""if rmq_connected:""
alt connected
    note right of Receiver
        Refer to //Draining queue.db (reconnect-triggered)// above —
        this trigger calls the identical ""_drain_fallback()"",
        including its single-flight guard.
    end note
else not connected
    Receiver -> Receiver : **Skip — nothing to do this tick**
end

@enduml
