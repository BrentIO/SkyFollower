@startuml
!include ../../images/common-sequence.iuml

title Receiver — RabbitMQ Offline Fallback

box "Receiver" $OnPrem
    participant "Source thread\n(per readsb feed)" as Src
    participant "In-memory\nlive queue" as LiveQ
    participant "In-memory\noverflow queue" as OverQ
    participant "Overflow-writer\nthread" as OWrite
    participant "RabbitMQ thread" as Rmq
    database "queue.db" as ReceiverDB
end box

box "RabbitMQ" $OnPrem
    entity "adsb exchange\n(x-consistent-hash)" as AdsbX
end box

note over Src, ReceiverDB
    **backlogged** is a single shared, in-memory boolean — not a queue.db
    query — so checking it costs nothing on the hot path. It is the only
    thing that decides where a message is routed: while it is set, a
    message can never reach RabbitMQ ahead of anything already queued.
    See #1956 — this replaces "always drain the live queue first", which
    let freshly-arriving live messages leapfrog an older on-disk backlog.
end note

== Source thread — never blocks on RabbitMQ, never writes to disk ==

loop For each parsed message
    alt backlogged is set (a real backlog already exists)
        Src -> OverQ++ : **Always spill while behind — never touch the live queue**\n""overflow_queue.put_nowait((icao_hex, message_json))""
        alt overflow queue has room
            OverQ --> Src-- : Buffered
        else overflow queue also full (last-resort pressure valve)
            OverQ --> Src-- : Full
            Src -> ReceiverDB++ : **Write one row directly**\n""INSERT INTO queue {routing_key, message_json}""
            ReceiverDB --> Src-- : OK
        end
    else backlogged is clear (caught up)
        Src -> LiveQ++ : **Hand off the parsed message**\n""live_queue.put_nowait((icao_hex, message_json))""
        alt live queue has room
            LiveQ --> Src-- : Buffered
        else live queue full (broker unreachable, or publishing can't keep pace)
            LiveQ --> Src-- : Full
            Src -> Src : **Set backlogged**\n""backlogged = True""
            note right of Src
                From this instant, every subsequent message — from every
                source thread — routes to the overflow queue instead of
                the live queue, until the RabbitMQ thread confirms a full
                drain below. This is what stops the live queue from ever
                being topped up with newer content while queue.db still
                holds older, undelivered rows.
            end note
            Src -> OverQ++ : **Hand off to the overflow queue**\n""overflow_queue.put_nowait((icao_hex, message_json))""
            alt overflow queue has room
                OverQ --> Src-- : Buffered
            else overflow queue also full (last-resort pressure valve)
                OverQ --> Src-- : Full
                Src -> ReceiverDB++ : **Write one row directly**\n""INSERT INTO queue {routing_key, message_json}""
                ReceiverDB --> Src-- : OK
            end
        end
    end
    Src -> Src : **Return straight to the socket**\n""sock.recv() — no pika call, no broker wait""
end

== Overflow-writer thread — batches overflow to disk, off the socket-read path ==

loop While running
    OWrite -> OverQ++ : **Wait for the next overflow message**\n""overflow_queue.get(timeout=1s)""
    OverQ --> OWrite-- : (routing_key, message_json)
    OWrite -> OverQ++ : **Take whatever else is queued, up to the batch cap**\n""overflow_queue.get_nowait() until empty or _OVERFLOW_WRITE_BATCH_MAX""
    OverQ --> OWrite-- : Batch of messages
    OWrite -> ReceiverDB++ : **Persist the whole batch in one commit**\n""executemany INSERT INTO queue …; COMMIT (synchronous=NORMAL, WAL)""
    ReceiverDB --> OWrite-- : OK
end

note over OverQ, OWrite
    On shutdown the writer makes one final pass, so messages still
    buffered in the overflow queue are persisted rather than lost.
end note

== RabbitMQ thread — sole publisher, drains oldest-first ==

Rmq -> AdsbX++ : **Connect**
AdsbX --> Rmq-- : Connected
Rmq -> Rmq : **Set RabbitMQ is Connected**\n""rmq_connected = True""

loop While connected
    Rmq -> Rmq : **Publish path latched a failure?**\n""if not rmq_connected: break to reconnect""
    Rmq -> Rmq : **Service the connection**\n""conn.process_data_events(time_limit=0) — heartbeats, blocked/unblocked""

    group Drain whatever the live queue already holds (bounded per pass)
        loop While the live queue is non-empty
            Rmq -> LiveQ++ : **Take next message**\n""live_queue.get_nowait()""
            LiveQ --> Rmq-- : (routing_key, message_json)
            Rmq -\ AdsbX : **Publish**\n""channel.basic_publish(exchange='adsb', routing_key=icao_hex)""
            opt basic_publish raises
                Rmq -> Rmq : **Set RabbitMQ is Disconnected, set backlogged**\n""rmq_connected = False; backlogged = True""
                Rmq -> ReceiverDB++ : **Persist the message**\n""INSERT INTO queue {routing_key, message_json}""
                ReceiverDB --> Rmq-- : OK
                break
                    Rmq -> Rmq : **Stop the pass**\n""next loop guard sees the latch and reconnects""
                end
            end
        end
        note right of Rmq
            Because source threads only feed the live queue while
            **backlogged** is clear, nothing new can land here once a
            backlog exists — this drains strictly the content that was
            already sitting here before the backlog began, never anything
            newer than what queue.db is holding.
        end note
    end

    alt live queue was observed empty
        Rmq -> ReceiverDB++ : **Select the next batch, oldest first**\n""SELECT id, payload, retry_count, last_attempted_at FROM queue ORDER BY id ASC LIMIT 100""
        ReceiverDB --> Rmq-- : Up to 100 rows (or empty)
        loop For each selected row, in id order
            alt row attempted less than 30s ago
                break
                    Rmq -> Rmq : **Stop the batch here**\n""cooling down — the pass never skips past it to a fresher row""
                end
            else row eligible to retry
                Rmq -\ AdsbX : **Publish**\n""channel.basic_publish(exchange='adsb', routing_key=icao_hex)""
                opt basic_publish raises
                    Rmq -> Rmq : **Set RabbitMQ is Disconnected**\n""rmq_connected = False""
                    Rmq -> Rmq : **Count this failure**\n""new_count = retry_count + 1""
                    alt new_count reaches the retry threshold (5)
                        Rmq -> ReceiverDB++ : **Dead-letter this one row**\n""DELETE FROM queue WHERE id = {id}; write dead_letters/queue/{timestamp}_{id}.json""
                        ReceiverDB --> Rmq-- : OK
                        note right of Rmq
                            Judged permanently unrecoverable, not a
                            transient outage — the batch still stops here,
                            but this row is gone rather than blocking
                            everything behind it on the next pass.
                        end note
                    else new_count still below the retry threshold
                        Rmq -> ReceiverDB++ : **Record the failed attempt**\n""UPDATE queue SET retry_count = {new_count}, last_attempted_at = {now} WHERE id = {id}""
                        ReceiverDB --> Rmq-- : OK
                    end
                    break
                        Rmq -> Rmq : **Stop the batch at the first failure**\n""next loop guard sees the latch and reconnects""
                    end
                end
            end
        end
        opt one or more rows published this batch
            Rmq -> ReceiverDB++ : **Delete the whole published prefix in one commit**\n""DELETE FROM queue WHERE id IN (…succeeded ids…); COMMIT""
            ReceiverDB --> Rmq-- : OK
        end
        opt queue.db confirmed empty after this batch, and the live queue is also empty
            Rmq -> Rmq : **Clear backlogged**\n""backlogged = False""
            note right of Rmq
                Only cleared on a *confirmed* full drain of both queues —
                never merely "small enough". Source threads resume
                feeding the live queue directly from this point on.
            end note
        end
    else live queue still had traffic
        Rmq -> Rmq : **Loop — re-check the live queue before the next batch**
    end
end

note over Rmq
    A separate, informational-only check runs alongside this loop:
    ""staleness = now - head_of_queue.received_at"" (whichever of the live
    queue's or queue.db's oldest row is older). This never gates routing —
    it is exposed as a health/telemetry signal ("how far behind are we
    right now") for logs, Home Assistant, and downstream consumers such as
    the message processor's own tolerance for the rare out-of-order
    message (cross-receiver skew — see #1956).
end note

== Connection drops, or a publish latched it unhealthy ==

alt the connection itself failed
    AdsbX ->x Rmq : **Connection lost**
    Rmq -> Rmq : **Connection monitoring detects the drop**\n""conn.process_data_events() raises AMQPConnectionError""
else a publish failed but the socket stayed up
    Rmq -> Rmq : **Inner loop sees the latch**\n""if not rmq_connected: break""
    note right of Rmq
        A broker blocking publishers on a resource alarm keeps
        process_data_events() succeeding — the latched flag, not a
        connection exception, is what forces the reconnect.
        blocked_connection_timeout bounds how long a publish can wedge
        before pika tears the connection down.
    end note
end
Rmq -> Rmq : **Set RabbitMQ is Disconnected**\n""rmq_connected = False""

loop Until reconnected
    alt Connection fails
        Rmq ->x AdsbX : **Connect**
        Rmq -> Rmq : **Sleep 10 seconds**
    else Connection succeeds
        Rmq -> AdsbX++ : **Connect**
        AdsbX --> Rmq-- : Connected
        Rmq -> Rmq : **Set RabbitMQ is Connected**\n""rmq_connected = True""
        note right of Rmq
            The publish loop above resumes. **backlogged** is still set
            from before the disconnect, so source threads keep spilling to
            queue.db — the first passes drain whatever the live queue
            already held, then queue.db oldest-first, exactly as before a
            reconnect, until a confirmed empty drain clears the flag.
        end note
    end
end

@enduml
