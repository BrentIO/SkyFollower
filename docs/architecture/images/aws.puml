@startuml
' Pure include-fragment: consumed by pipeline.puml via
' `!includesub aws.puml!COMPONENT`, never displayed as a standalone diagram.
' generate-diagrams.mjs still renders this file to aws.svg like every other
' .puml (see that script's comments) — nothing references the standalone
' SVG, but that's a harmless, intentional side effect of keeping the
' generator's file-discovery simple, not a bug. See issue #1867.
!include_once ../../images/common-component.iuml

!startsub COMPONENT
package "AWS" $AWS {
    interface "S3 Public API" as s3
    component S3 as s3svc
    s3 -down- s3svc

    interface "Athena Public API" as athena
    component "Athena" as athenasvc
    athena -down- athenasvc

    component "Glue Catalog\n(partition projection)" as glue

    s3svc -right-> glue : Parquet index\n(index/year={YYYY}/month={MM}/day={DD}/{uuid}.parquet)
    athenasvc -up-> glue : Query
    athenasvc -down-> s3svc : Scan matching partitions
}
!endsub

@enduml
