# docker-compose.core.yaml pins the ofelia image to mcuadros/ofelia:latest,
# which currently resolves to the 0.3.x release line (0.4.x has never left
# beta -- no stable tag exists to pin to instead). 0.3.x's cron parser
# REQUIRES 6 fields with a leading seconds value: "sec min hour dom month
# dow" -- standard 5-field cron (no seconds) is only auto-detected starting
# in Ofelia 0.4.x. A schedule written with only 5 fields silently
# left-aligns into the wrong fields instead of erroring (e.g. "50 4 * * *",
# intended as daily at 04:50, misparses as hourly at :04:50).
# Every schedule below must keep its leading "0" (or whatever second you
# actually want) -- don't drop back to 5 fields when adding a new job.
[job-run "runner-ourairports"]
schedule = 0 10 5 * * 1
image = ghcr.io/brentio/skyfollower-runner-ourairports:latest
network = skyfollower-core_default
volume = __ROOT_DIRECTORY__/config/runners/settings.json:/app/settings.json:ro
volume = __ROOT_DIRECTORY__/config/runners:/app/config:ro
delete = true

# uk-caa-registry makes 676 prefix search calls + per-aircraft detail fetches and takes several hours.
# Schedule it as the last runner of the day.
[job-run "runner-uk-caa-registry"]
schedule = 0 10 6 * * 1
image = ghcr.io/brentio/skyfollower-runner-uk-caa-registry:latest
network = skyfollower-core_default
volume = __ROOT_DIRECTORY__/config/runners/settings.json:/app/settings.json:ro
delete = true

