# Tuned for a constrained host (Raspberry Pi CM4008032, 8GB RAM/32GB eMMC)
# shared with Redis, ofelia, and periodic data-runner containers. Absolute
# values are used instead of the relative-by-host-RAM defaults, since the
# real memory/disk budget for this host is now known. Starting points, not
# measured values -- there's no production traffic yet to tune against.
vm_memory_high_watermark.absolute = 2GB
disk_free_limit.absolute = 2GB
