{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LegacyMigrationReadSource",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::__SOURCE_BUCKET_NAME__",
        "arn:aws:s3:::__SOURCE_BUCKET_NAME__/*"
      ]
    },
    {
      "Sid": "LegacyMigrationWriteDestination",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::__DEST_BUCKET_NAME__/flights/*",
        "arn:aws:s3:::__DEST_BUCKET_NAME__/index/*"
      ]
    },
    {
      "Sid": "LegacyMigrationVerifyDestination",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::__DEST_BUCKET_NAME__",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "flights/*",
            "index/*"
          ]
        }
      }
    }
  ]
}
