# tools/legacy-migration -- copy to tools/legacy-migration/.env and fill in.
# Gitignored (see the repo-root .gitignore's blanket ".env" rule).
#
# Pass it explicitly, since this compose file's project directory is the
# repo root, not tools/legacy-migration/:
#
#   docker compose -f docker-compose.legacy-migration.yaml \
#     --env-file tools/legacy-migration/.env \
#     run --rm producer --start-date 2022-07-11 --end-date 2026-09-01
#
# See README.md for what each value means and how to obtain it.

LOG_LEVEL=info

# --- Legacy MongoDB: the read-only skyfollower-migration user (see "Mongo credential" in README.md) ---
MONGO_URI=mongodb://skyfollower-migration:PASSWORD@LEGACY_MONGO_HOST:27017/SkyFollower?authSource=SkyFollower
MONGO_DATABASE=SkyFollower
MONGO_COLLECTION=flights

# --- S3 ---
SOURCE_S3_BUCKET=com.skyfollower.datastore
DEST_S3_BUCKET=NEW_ARCHIVE_BUCKET

# --- Temporary copy-only IAM identity (see "IAM" in README.md) ---
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- RabbitMQ: dedicated skyfollower-migration user on the core host (see "RabbitMQ setup" in README.md) ---
# RABBITMQ_HOST must be reachable from wherever this tool runs -- if the
# migration containers run on a different host than docker-compose.core.yaml,
# that core host must allow inbound 5672 from this one.
RABBITMQ_HOST=CORE_HOST
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=skyfollower-migration
RABBITMQ_PASSWORD=
